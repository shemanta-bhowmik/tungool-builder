{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "tungool-builder/button",
	"version": "1.0.0",
	"title": "TB Button",
	"category": "tungool-builder",
	"parent": [ "tungool-builder/buttons", "tungool-builder/container" ],
	"icon": "button",
	"description": "A link or button with style presets, an optional icon, hover colors and responsive sizing.",
	"keywords": [ "button", "link", "cta", "call to action" ],
	"textdomain": "tungool-builder",
	"attributes": {
		"uniqueId": { "type": "string", "default": "" },
		"text": { "type": "string", "default": "" },
		"url": { "type": "string", "default": "" },
		"opensInNewTab": { "type": "boolean", "default": false },
		"nofollow": { "type": "boolean", "default": false },
		"sponsored": { "type": "boolean", "default": false },
		"ariaLabel": { "type": "string", "default": "" },
		"preset": { "type": "string", "default": "primary" },
		"icon": { "type": "string", "default": "" },
		"iconPosition": { "type": "string", "default": "after" },
		"iconSize": { "type": "object", "default": {} },
		"iconGap": { "type": "object", "default": {} },
		"padding": { "type": "object", "default": {} },
		"typography": { "type": "object", "default": {} },
		"widthMode": { "type": "object", "default": {} },
		"customWidth": { "type": "object", "default": {} },
		"textColor": { "type": "object", "default": {} },
		"background": { "type": "object", "default": {} },
		"border": { "type": "object", "default": {} },
		"boxShadow": { "type": "object", "default": {} },
		"transitionDuration": { "type": "number", "default": 300 }
	},
	"supports": {
		"html": false,
		"anchor": true,
		"className": true,
		"reusable": false
	},
	"example": {
		"attributes": { "text": "Get started", "preset": "primary", "icon": "arrow-right" }
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
