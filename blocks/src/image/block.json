{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "tungool-builder/image",
	"version": "1.0.0",
	"title": "TB Image",
	"category": "tungool-builder",
	"description": "A responsive image with sizing, aspect ratio, filters, hover effects, an optional caption, link or lightbox.",
	"keywords": [ "image", "photo", "picture", "media", "lightbox" ],
	"textdomain": "tungool-builder",
	"attributes": {
		"uniqueId": { "type": "string", "default": "" },
		"id": { "type": "number", "default": 0 },
		"url": { "type": "string", "default": "" },
		"alt": { "type": "string", "default": "" },
		"width": { "type": "number", "default": 0 },
		"height": { "type": "number", "default": 0 },
		"sizeSlug": { "type": "string", "default": "large" },
		"showCaption": { "type": "boolean", "default": false },
		"caption": { "type": "string", "default": "" },
		"disableLazy": { "type": "boolean", "default": false },
		"linkTo": { "type": "string", "default": "none" },
		"href": { "type": "string", "default": "" },
		"opensInNewTab": { "type": "boolean", "default": false },
		"nofollow": { "type": "boolean", "default": false },
		"sponsored": { "type": "boolean", "default": false },
		"lightbox": { "type": "boolean", "default": false },
		"alignment": { "type": "object", "default": {} },
		"imgWidth": { "type": "object", "default": {} },
		"maxWidth": { "type": "object", "default": {} },
		"imgHeight": { "type": "object", "default": {} },
		"objectFit": { "type": "object", "default": {} },
		"objectPosition": { "type": "object", "default": {} },
		"aspectRatio": { "type": "object", "default": {} },
		"customAspectRatio": { "type": "object", "default": {} },
		"border": { "type": "object", "default": {} },
		"boxShadow": { "type": "object", "default": {} },
		"opacity": { "type": "number", "default": 100 },
		"hoverEffect": { "type": "string", "default": "none" },
		"transitionDuration": { "type": "number", "default": 300 },
		"filters": { "type": "object", "default": {} },
		"captionTypography": { "type": "object", "default": {} },
		"captionColor": { "type": "object", "default": {} }
	},
	"supports": {
		"html": false,
		"anchor": true,
		"className": true,
		"align": [ "wide", "full" ],
		"spacing": { "margin": true }
	},
	"example": {
		"attributes": {
			"url": "https://s.w.org/images/core/5.3/MtBlanc1.jpg",
			"alt": "Mont Blanc",
			"showCaption": true,
			"caption": "Mont Blanc appears, still and serene."
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
