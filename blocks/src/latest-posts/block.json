{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "tungool-builder/latest-posts",
    "version": "1.0.0",
    "title": "TB Latest Posts",
    "category": "tungool-builder",
    "icon": "smiley",
    "description": "A simple plugin to add custom blocks to Gutenberg",
    "example": {},
    "supports": {
        "align": ["left", "center", "right"],
        "html": false,
        "inserter": false
    }, 
    "attributes": {
        "postType": {
            "type": "string",
            "default": "post"
        },
        "postToShow": {
            "type": "number",
            "default": 5
        },
        "displayImage": {
            "type": "boolean",
            "default": false
        },
        "displayExcerpt": {
            "type": "boolean",
            "default": false
        }
    },
    "textdomain": "tungool-builder",
    "editorScript": "file:./index.js",
    "editorStyle": "file:./index.css",
    "style": "file:./style-index.css",
    "render": "file:./render.php",
    "viewScript": "file:./view.js"
}