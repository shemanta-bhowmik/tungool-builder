{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "tungool-builder/tab",
	"version": "1.0.0",
	"title": "TB Tab",
	"category": "tungool-builder",
	"parent": [ "tungool-builder/tabs" ],
	"icon": "table-row-after",
	"description": "One tab of a TB Tabs block: a title, an optional icon and any blocks as content.",
	"keywords": [ "tab", "panel" ],
	"textdomain": "tungool-builder",
	"attributes": {
		"uniqueId": { "type": "string", "default": "" },
		"title": { "type": "string", "default": "" },
		"icon": { "type": "string", "default": "" }
	},
	"supports": {
		"html": false,
		"anchor": true,
		"className": true,
		"reusable": false
	},
	"example": {
		"attributes": { "title": "Overview" },
		"innerBlocks": [ { "name": "core/paragraph", "attributes": { "content": "Tab content." } } ]
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
