{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "tungool-builder/info-box",
	"version": "1.0.0",
	"title": "TB Info Box",
	"category": "tungool-builder",
	"icon": "info-outline",
	"description": "A feature box with an icon, image or number, a title, a description, an optional button and an optional whole-box link.",
	"keywords": [ "info box", "feature", "icon box", "service", "card" ],
	"textdomain": "tungool-builder",
	"attributes": {
		"uniqueId": { "type": "string", "default": "" },
		"mediaType": { "type": "string", "default": "icon" },
		"icon": { "type": "string", "default": "star" },
		"image": { "type": "object", "default": {} },
		"number": { "type": "string", "default": "01" },
		"mediaPosition": { "type": "object", "default": { "desktop": "top" } },
		"textAlign": { "type": "object", "default": {} },
		"title": { "type": "string", "default": "" },
		"titleTag": { "type": "string", "default": "h3" },
		"description": { "type": "string", "default": "" },
		"showButton": { "type": "boolean", "default": false },
		"button": { "type": "object", "default": { "text": "", "preset": "primary", "iconPosition": "after" } },
		"linkUrl": { "type": "string", "default": "" },
		"linkNewTab": { "type": "boolean", "default": false },
		"linkLabel": { "type": "string", "default": "" },
		"mediaSize": { "type": "object", "default": {} },
		"mediaShape": { "type": "string", "default": "none" },
		"mediaPadding": { "type": "object", "default": {} },
		"mediaGap": { "type": "object", "default": {} },
		"mediaColor": { "type": "object", "default": {} },
		"mediaBackground": { "type": "object", "default": {} },
		"numberTypography": { "type": "object", "default": {} },
		"titleTypography": { "type": "object", "default": {} },
		"titleColor": { "type": "object", "default": {} },
		"titleSpacing": { "type": "object", "default": {} },
		"descTypography": { "type": "object", "default": {} },
		"descColor": { "type": "object", "default": {} },
		"descSpacing": { "type": "object", "default": {} },
		"padding": { "type": "object", "default": {} },
		"background": { "type": "object", "default": {} },
		"border": { "type": "object", "default": {} },
		"boxShadow": { "type": "object", "default": {} },
		"hoverShadow": { "type": "object", "default": {} },
		"hoverLift": { "type": "number", "default": 0 },
		"transitionDuration": { "type": "number", "default": 300 }
	},
	"supports": {
		"html": false,
		"anchor": true,
		"className": true,
		"spacing": { "margin": true }
	},
	"example": {
		"attributes": {
			"icon": "star",
			"mediaShape": "circle",
			"title": "Fast by default",
			"description": "Dynamic blocks with per-instance CSS and no page-builder bloat."
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
