{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "tungool-builder/post-grid",
	"version": "1.0.0",
	"title": "TB Post Grid",
	"category": "tungool-builder",
	"icon": "grid-view",
	"description": "A grid or list of posts from any post type, with query filters, card parts, pagination or load more.",
	"keywords": [ "posts", "grid", "blog", "query", "latest posts", "list" ],
	"textdomain": "tungool-builder",
	"attributes": {
		"uniqueId": { "type": "string", "default": "" },
		"postType": { "type": "string", "default": "post" },
		"taxonomy": { "type": "string", "default": "" },
		"terms": { "type": "array", "default": [] },
		"includePosts": { "type": "array", "default": [] },
		"excludePosts": { "type": "array", "default": [] },
		"authors": { "type": "array", "default": [] },
		"order": { "type": "string", "default": "desc" },
		"orderBy": { "type": "string", "default": "date" },
		"offset": { "type": "number", "default": 0 },
		"perPage": { "type": "number", "default": 6 },
		"excludeCurrent": { "type": "boolean", "default": true },
		"sticky": { "type": "string", "default": "ignore" },
		"layout": { "type": "string", "default": "grid" },
		"columns": { "type": "object", "default": { "desktop": "3", "tablet": "2", "mobile": "1" } },
		"gap": { "type": "object", "default": {} },
		"equalHeight": { "type": "boolean", "default": true },
		"partsOrder": { "type": "array", "default": [ "image", "title", "meta", "excerpt", "readMore" ] },
		"showImage": { "type": "boolean", "default": true },
		"showTitle": { "type": "boolean", "default": true },
		"showMeta": { "type": "boolean", "default": true },
		"showExcerpt": { "type": "boolean", "default": true },
		"showReadMore": { "type": "boolean", "default": false },
		"imageSize": { "type": "string", "default": "medium_large" },
		"imageRatio": { "type": "string", "default": "16/9" },
		"lazyLoad": { "type": "boolean", "default": true },
		"titleTag": { "type": "string", "default": "h3" },
		"metaDate": { "type": "boolean", "default": true },
		"metaAuthor": { "type": "boolean", "default": true },
		"metaTerms": { "type": "boolean", "default": false },
		"metaTaxonomy": { "type": "string", "default": "category" },
		"metaComments": { "type": "boolean", "default": false },
		"excerptLength": { "type": "number", "default": 20 },
		"readMoreText": { "type": "string", "default": "" },
		"readMorePreset": { "type": "string", "default": "text" },
		"pagination": { "type": "string", "default": "none" },
		"loadMoreText": { "type": "string", "default": "" },
		"hoverEffect": { "type": "string", "default": "none" },
		"cardBackground": { "type": "object", "default": {} },
		"cardBorder": { "type": "object", "default": {} },
		"cardPadding": { "type": "object", "default": {} },
		"cardShadow": { "type": "object", "default": {} },
		"cardHoverShadow": { "type": "object", "default": {} },
		"imageRadius": { "type": "object", "default": {} },
		"titleTypography": { "type": "object", "default": {} },
		"titleColor": { "type": "object", "default": {} },
		"metaTypography": { "type": "object", "default": {} },
		"metaColor": { "type": "object", "default": {} },
		"excerptTypography": { "type": "object", "default": {} },
		"excerptColor": { "type": "object", "default": {} },
		"readMoreColor": { "type": "object", "default": {} }
	},
	"supports": {
		"html": false,
		"anchor": true,
		"className": true,
		"align": [ "wide", "full" ],
		"spacing": { "margin": true, "padding": true }
	},
	"example": {
		"attributes": { "perPage": 3, "columns": { "desktop": "3" } }
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
