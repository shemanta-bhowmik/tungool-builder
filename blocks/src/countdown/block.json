{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "tungool-builder/countdown",
	"version": "1.0.0",
	"title": "TB Countdown",
	"category": "tungool-builder",
	"icon": "clock",
	"description": "A countdown timer to a fixed date or an evergreen per-visitor deadline, with boxes or inline layout and an end action.",
	"keywords": [ "countdown", "timer", "deadline", "launch", "sale" ],
	"textdomain": "tungool-builder",
	"attributes": {
		"uniqueId": { "type": "string", "default": "" },
		"mode": { "type": "string", "default": "fixed" },
		"date": { "type": "string", "default": "" },
		"evergreenHours": { "type": "number", "default": 24 },
		"evergreenMinutes": { "type": "number", "default": 0 },
		"showDays": { "type": "boolean", "default": true },
		"showHours": { "type": "boolean", "default": true },
		"showMinutes": { "type": "boolean", "default": true },
		"showSeconds": { "type": "boolean", "default": true },
		"showLabels": { "type": "boolean", "default": true },
		"labels": { "type": "object", "default": {} },
		"onEnd": { "type": "string", "default": "message" },
		"endMessage": { "type": "string", "default": "" },
		"redirectUrl": { "type": "string", "default": "" },
		"layout": { "type": "string", "default": "boxes" },
		"separator": { "type": "string", "default": "" },
		"align": { "type": "object", "default": {} },
		"gap": { "type": "object", "default": {} },
		"digitTypography": { "type": "object", "default": {} },
		"digitColor": { "type": "object", "default": {} },
		"labelTypography": { "type": "object", "default": {} },
		"labelColor": { "type": "object", "default": {} },
		"boxBackground": { "type": "object", "default": {} },
		"boxBorder": { "type": "object", "default": {} },
		"boxPadding": { "type": "object", "default": {} },
		"boxMinWidth": { "type": "object", "default": {} },
		"separatorColor": { "type": "object", "default": {} },
		"messageTypography": { "type": "object", "default": {} },
		"messageColor": { "type": "object", "default": {} }
	},
	"supports": {
		"html": false,
		"anchor": true,
		"className": true,
		"spacing": { "margin": true, "padding": true }
	},
	"example": {
		"attributes": { "mode": "evergreen", "evergreenHours": 50, "align": { "desktop": "center" } }
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js",
	"render": "file:./render.php"
}
