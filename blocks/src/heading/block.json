{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "tungool-builder/heading",
	"version": "1.0.0",
	"title": "TB Heading",
	"category": "tungool-builder",
	"icon": "heading",
	"description": "A heading with selectable level (H1–H6), text alignment, colors and background.",
	"keywords": [
		"heading",
		"title",
		"h1",
		"h2"
	],
	"textdomain": "tungool-builder",
	"attributes": {
		"uniqueId": {
			"type": "string",
			"default": ""
		},
		"content": {
			"type": "string",
			"default": "TB Heading"
		},
		"level": {
			"type": "number",
			"default": 2
		},
		"align": {
			"type": "string",
			"default": "left"
		},
		"typography": {
			"type": "object",
			"default": {}
		},
		"padding": {
			"type": "object",
			"default": {}
		},
		"margin": {
			"type": "object",
			"default": {}
		},
		"hoverColor": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"className": true,
		"color": {
			"text": true,
			"background": true
		},
		"background": {
			"backgroundImage": true
		}
	},
	"example": {
		"attributes": {
			"content": "Build pages faster with Tungool Blocks",
			"level": 2,
			"align": "left"
		}
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
