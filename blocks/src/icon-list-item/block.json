{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "tungool-builder/icon-list-item",
	"version": "1.0.0",
	"title": "TB Icon List Item",
	"category": "tungool-builder",
	"parent": [ "tungool-builder/icon-list" ],
	"icon": "yes",
	"description": "One item of a TB Icon List: an icon, text and an optional link.",
	"keywords": [ "list item", "icon" ],
	"textdomain": "tungool-builder",
	"attributes": {
		"icon": { "type": "string", "default": "" },
		"text": { "type": "string", "default": "" },
		"url": { "type": "string", "default": "" },
		"opensInNewTab": { "type": "boolean", "default": false },
		"nofollow": { "type": "boolean", "default": false },
		"sponsored": { "type": "boolean", "default": false }
	},
	"usesContext": [ "tungool-builder/iconListIcon" ],
	"supports": {
		"html": false,
		"anchor": true,
		"className": true,
		"reusable": false
	},
	"example": {
		"attributes": { "text": "Unlimited projects" }
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
