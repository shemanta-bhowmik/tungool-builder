{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "tungool-builder/container",
	"version": "1.0.0",
	"title": "TB Container",
	"category": "tungool-builder",
	"icon": "layout",
	"description": "A flexible flex or grid section that holds other blocks, with responsive layout, background, overlay, border, shadow and hover styles.",
	"keywords": [
		"container",
		"section",
		"row",
		"columns",
		"grid",
		"flex",
		"wrapper"
	],
	"textdomain": "tungool-builder",
	"attributes": {
		"uniqueId": {
			"type": "string",
			"default": ""
		},
		"tagName": {
			"type": "string",
			"default": "div"
		},
		"contentWidth": {
			"type": "string",
			"default": "boxed"
		},
		"maxWidth": {
			"type": "object",
			"default": {}
		},
		"minHeight": {
			"type": "object",
			"default": {}
		},
		"display": {
			"type": "object",
			"default": {}
		},
		"direction": {
			"type": "object",
			"default": {}
		},
		"justify": {
			"type": "object",
			"default": {}
		},
		"alignItems": {
			"type": "object",
			"default": {}
		},
		"wrap": {
			"type": "object",
			"default": {}
		},
		"gap": {
			"type": "object",
			"default": {}
		},
		"gridColumns": {
			"type": "object",
			"default": {}
		},
		"padding": {
			"type": "object",
			"default": {}
		},
		"margin": {
			"type": "object",
			"default": {}
		},
		"background": {
			"type": "object",
			"default": {}
		},
		"border": {
			"type": "object",
			"default": {}
		},
		"boxShadow": {
			"type": "object",
			"default": {}
		},
		"hideOn": {
			"type": "object",
			"default": {}
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"className": true,
		"align": [
			"wide",
			"full"
		],
		"color": {
			"text": true,
			"link": true,
			"background": false
		}
	},
	"example": {
		"attributes": {
			"display": {
				"desktop": "grid"
			},
			"gridColumns": {
				"desktop": "2"
			},
			"gap": {
				"desktop": "16px"
			},
			"padding": {
				"desktop": {
					"top": "24px",
					"right": "24px",
					"bottom": "24px",
					"left": "24px"
				}
			},
			"border": {
				"width": "1px",
				"style": "solid",
				"color": "#dddddd",
				"radius": {
					"desktop": "8px"
				}
			}
		},
		"innerBlocks": [
			{
				"name": "tungool-builder/heading",
				"attributes": {
					"content": "Container",
					"level": 3
				}
			},
			{
				"name": "core/paragraph",
				"attributes": {
					"content": "Flex or grid layout, background, overlay and hover styles."
				}
			}
		]
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
